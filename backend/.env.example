# ============================================================
# Ethio Matric Academy — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.yeblwjyiztuuehiefixy.supabase.co:5432/postgres

# ── JWT Secrets ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Email (Nodemailer / Gmail) ────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Ethio Matric Academy <noreply@ethiomatric.com>"

# ── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Payment Gateways ─────────────────────────────────────────
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_CALLBACK_URL=https://your-render-domain.onrender.com/api/payments/chapa/callback
CHAPA_RETURN_URL=https://your-frontend-domain.com/dashboard/subscription
# Webhook signing secret — get from Chapa dashboard → Settings → Webhooks
CHAPA_WEBHOOK_SECRET=

TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=

SANTIMPAY_API_KEY=
SANTIMPAY_MERCHANT_ID=

# ── AI / OpenAI (optional — system works without it) ─────────
OPENAI_API_KEY=
